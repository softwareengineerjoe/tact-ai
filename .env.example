# ---- Local development environment ----
# Copy to .env and adjust. Never commit real secrets (MASTER section 28).

ENVIRONMENT=local

# PostgreSQL (matches docker-compose service "db")
POSTGRES_USER=tact
POSTGRES_PASSWORD=tact_local_password
POSTGRES_DB=tact
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Async SQLAlchemy connection string (asyncpg)
DATABASE_URL=postgresql+asyncpg://tact:tact_local_password@localhost:5432/tact

# AI model deployment names are configuration, never hardcoded (MASTER 18.4).
AI_MODEL_DEPLOYMENT=configure-me
AI_EMBEDDING_DEPLOYMENT=configure-me

# Frontend
VITE_API_BASE_URL=http://localhost:8000
