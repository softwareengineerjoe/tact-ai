# Example backend configuration. Copy to `.env` and fill in real values.
# `.env` is gitignored; never commit real secrets.

DATABASE_URL=postgresql+asyncpg://tact:tact_local_password@localhost:5432/tact

# Foundry AI assistant (Sprint 5). Leave endpoint/key blank to use the
# deterministic local provider (no credentials needed for tests/offline dev).
AI_FOUNDRY_ENDPOINT=
AI_FOUNDRY_API_KEY=
AI_FOUNDRY_API_VERSION=2025-04-01-preview
AI_MODEL_DEPLOYMENT=gpt-4.1
